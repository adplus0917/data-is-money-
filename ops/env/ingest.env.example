# INGEST WORKER (vault rack). staging GET+DELETE · master PUT+GET · quarantine PUT. No viewing keys.
NODE_ENV=production
DATABASE_URL=
NOTIFY_WEBHOOK_URL=
CLAMD_HOST=clamav
CLAMD_PORT=3310
STAGING_BUCKET=dp-staging
STAGING_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STAGING_S3_REGION=auto
STAGING_ACCESS_KEY_ID=          # ingest-pull key
STAGING_SECRET_ACCESS_KEY=
MASTER_BUCKET=dp-master
MASTER_S3_ENDPOINT=http://minio-master:9000
MASTER_ACCESS_KEY_ID=svc-ingest
MASTER_SECRET_ACCESS_KEY=
QUARANTINE_BUCKET=dp-quarantine
QUARANTINE_S3_ENDPOINT=http://minio-master:9000
QUARANTINE_ACCESS_KEY_ID=svc-ingest
QUARANTINE_SECRET_ACCESS_KEY=
