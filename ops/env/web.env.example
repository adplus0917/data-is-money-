# WEBSITE (cloud). Staging keys: PUT only.
NODE_ENV=production
DATABASE_URL=
ADMIN_PASSWORD=
SESSION_SECRET=
PUBLIC_URL=https://datapatrimonio.com
DATAROOM_URL=https://room.datapatrimonio.com
