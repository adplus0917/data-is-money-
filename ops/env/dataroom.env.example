# DATA ROOM (vault rack, DMZ). viewing GET only. It refuses to start if given any other keys.
NODE_ENV=production
DATABASE_URL=                   # use the dp_dataroom database role (ops/db-roles.sql)
NOTIFY_WEBHOOK_URL=
DATAROOM_PORT=4000
DATAROOM_IDLE_MINUTES=30
DATAROOM_MAX_PAGES_PER_MIN=10   # merged default: matches the e2e suite; session is cut above this
DATAROOM_MAX_WARNINGS=10
DATAROOM_TMP=/tmp
VIEWING_BUCKET=dp-viewing
VIEWING_S3_ENDPOINT=http://minio-viewing:9000
VIEWING_ACCESS_KEY_ID=svc-dataroom
VIEWING_SECRET_ACCESS_KEY=
