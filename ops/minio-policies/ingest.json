{ "Version": "2012-10-17", "Statement": [
  { "Sid": "WriteAndVerifyMaster", "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"], "Resource": ["arn:aws:s3:::dp-master/*"] },
  { "Sid": "WriteQuarantine", "Effect": "Allow", "Action": ["s3:PutObject"], "Resource": ["arn:aws:s3:::dp-quarantine/*"] },
  { "Sid": "NeverDeleteMaster", "Effect": "Deny", "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutBucketPolicy", "s3:PutObjectRetention", "s3:BypassGovernanceRetention"], "Resource": ["arn:aws:s3:::dp-master", "arn:aws:s3:::dp-master/*"] },
  { "Sid": "NoViewing", "Effect": "Deny", "Action": ["s3:*"], "Resource": ["arn:aws:s3:::dp-viewing", "arn:aws:s3:::dp-viewing/*"] }
] }
