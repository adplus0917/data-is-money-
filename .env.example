# Copy this file to .env for local testing, or enter these in your host's dashboard.

# PostgreSQL connection string. Leave empty locally to use a simple file in ./data instead.
DATABASE_URL=

# Team-panel password (12+ characters in production).
ADMIN_PASSWORD=change-me-to-a-long-password

# Random secret that signs the team-panel cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where sample files are saved (private, never public). On Render use the persistent disk:
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# Company mailbox the site sends as (created via Google Workspace on dataismoney.ai).
OUTBOX_FROM=hola@dataismoney.ai

# Optional: Slack / Zapier / Make webhook that gets a message on every new submission.
NOTIFY_WEBHOOK_URL=

# Set to production on the live server.
NODE_ENV=development
PORT=3000

# Vault Object Lock — MUST stay off until Andrew Manie decides, in writing,
# COMPLIANCE vs GOVERNANCE. No default retention exists. See the gate note
# at the top of ops/setup-buckets.js.
VAULT_OBJECT_LOCK_MODE=off
