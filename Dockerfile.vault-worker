# ============================================================
# Vault worker image — cloud stand-in for the rack services in
# ops/rack/docker-compose.yml (same repo, worker entrypoints).
# Used by the ingest worker and the viewing-copy builder as Render
# background workers while the company rack is on hold. The ingest
# worker needs a LOCAL ClamAV daemon: the daemon + a baked signature
# database live in this image and the entrypoint starts clamd before
# the worker (the rack compose runs ClamAV as its own container; a
# single Render worker cannot, so it runs in-process here).
# ============================================================
FROM node:22-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends clamav-daemon clamav-freshclam poppler-utils fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /var/run/clamav /var/log/clamav /var/lib/clamav \
 && chown -R clamav:clamav /var/run/clamav /var/log/clamav /var/lib/clamav \
 && (grep -q '^TCPSocket' /etc/clamav/clamd.conf && sed -i 's/^TCPSocket.*/TCPSocket 3310/' /etc/clamav/clamd.conf || echo 'TCPSocket 3310' >> /etc/clamav/clamd.conf) \
 && (grep -q '^TCPAddr' /etc/clamav/clamd.conf && sed -i 's/^TCPAddr.*/TCPAddr 127.0.0.1/' /etc/clamav/clamd.conf || echo 'TCPAddr 127.0.0.1' >> /etc/clamav/clamd.conf) \
 && (freshclam --quiet || true)
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .
ENTRYPOINT ["sh", "/app/vault-worker-entrypoint.sh"]
CMD ["node", "server/index.js"]
